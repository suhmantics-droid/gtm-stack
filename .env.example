# Copy this file to ".env" in this folder and fill in your keys.
# .env is secret — never commit it. All have free tiers unless noted.

# --- Firmographics (UK) — FREE, no card. https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# --- Tech-stack detection — FREE tier (50 scans/day). https://urlscan.io/user/signup
URLSCAN_API_KEY=

# --- Web search / scrape MCPs
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Parallel Search needs NO key (HTTP MCP). Add it in .mcp.json only.

# --- Contact enrichment (optional, credit-metered — gate every call)
BLITZ_API_KEY=
LUSHA_API_KEY=

# --- Prospecting scraper (optional)
PHANTOMBUSTER_API_KEY=

# --- Google Workspace does NOT use a key here:
#   Sheets writes  -> service_account.json (recommended)
#   Create/Gmail   -> OAuth client_secret JSON, path set in .mcp.json
# See blueprints/data-home-google-sheets.md
